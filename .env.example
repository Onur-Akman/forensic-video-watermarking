# Project Specter — environment ornek dosyasi (contract section 2.1 / section 9).
# Bu dosya repo'ya commit edilir. Gercek anahtar ASLA bu dosyada degil; .env'de tutulur
# (.env zaten .gitignore'da). Production'da secret manager (Vault, AWS SM) inject eder.

# 256-bit (64 hex chars) master watermark key. Asagidaki deger contract section 2.1'de
# yayinlanan SADECE-LOKAL-GELISTIRME dummy key'idir; production'da degistirilmeli.
SPECTER_WM_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# Servis port'lari
EMBEDDER_PORT=8081
EXTRACTOR_PORT=8082

# Logging
LOG_LEVEL=INFO

# Embedder
MAX_UPLOAD_MB=500
H264_CRF=18

# Extractor
EXTRACTOR_MAX_FRAMES=90
